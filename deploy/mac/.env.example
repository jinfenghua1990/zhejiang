# Mac 本地运行模板
# 复制为项目根目录 .env 后填写真实值；不要提交 .env。

APP_ENV=development
RELEASE_CHANNEL=local
DEPLOYMENT_MODE=native

APP_SECRET_KEY=CHANGE_ME
# Mac 本地 / 受控局域网默认直达，不重复要求账号密码。
# 若未来把服务暴露到公网，必须改回 ACCESS_MODE=rbac。
ACCESS_MODE=open
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Mac 原生 PostgreSQL / Redis
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://ecommerce:CHANGE_ME@localhost:5432/ecommerce
# 可选：Alembic 专用账号；为空时继续沿用 DATABASE_URL。
MIGRATION_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# 数据与日志建议放在仓库外，避免代码更新影响业务数据
PERSIST_ROOT=/Users/<user>/ecommerce-workspace-data/local
DATA_DIR=/Users/<user>/ecommerce-workspace-data/local/data
BACKUP_DIR=/Users/<user>/ecommerce-workspace-data/local/backups
LOG_DIR=/Users/<user>/ecommerce-workspace-data/local/logs

# Mac 本地开发主线固定跟踪 develop
SYSTEM_UPDATE_ENABLED=1
SYSTEM_UPDATE_REMOTE=origin
SYSTEM_UPDATE_BRANCH=develop
SYSTEM_UPDATE_HEALTH_URL=http://127.0.0.1:8000/healthz
SYSTEM_UPDATE_LAUNCH_LABEL=com.gino.ecommerce-dashboard

# 业务集成凭证按需补充
JACKYUN_MCP_URL=
JACKYUN_APP_KEY=
JACKYUN_MCP_TOKEN=
JACKYUN_SYNC_MODE=manual

ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_REDIRECT_URI=

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare R2 主备份
# 每日模块化；默认每 10 天自动生成一次完整容灾恢复点。
R2_BACKUP_ENABLED=0
R2_BACKUP_ENDPOINT=
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY=
R2_BACKUP_SECRET_KEY=
R2_BACKUP_PREFIX=ecommerce-workspace/backup
R2_FULL_INTERVAL_DAYS=10
# 应用启动时自动确保本地基础、R2、Kodo 与恢复演练 launchd 计划已安装。
BACKUP_SCHEDULE_AUTO_INSTALL=1

# 七牛云 Kodo 国内冷备（只存不取）
# 选择“标准存储”空间；这里只配置上传能力，不配置下载/取回/恢复能力。
# 密钥填写完成后，再把 KODO_COLD_ENABLED 改为 1。
KODO_COLD_ENABLED=0
KODO_COLD_BUCKET=
KODO_COLD_UPLOAD_URL=
KODO_COLD_ACCESS_KEY=
KODO_COLD_SECRET_KEY=
KODO_COLD_PREFIX=ecommerce-workspace/cold
