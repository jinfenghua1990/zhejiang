# 极空间 STAGING 示例。复制为 .env 后填写真实值，不要提交 .env。
COMPOSE_PROJECT_NAME=ecommerce-staging
APP_IMAGE=ghcr.io/jinfenghua1990/zhejiang:candidate
WEB_PORT=8100
APP_ENV=staging
RELEASE_CHANNEL=candidate

POSTGRES_DB=ecommerce_staging
# staging owner/admin；与 production 使用不同密码和数据卷。
POSTGRES_USER=ecommerce_staging
POSTGRES_PASSWORD=CHANGE_ME_ADMIN
APP_DB_USER=ecommerce_staging_app
APP_DB_PASSWORD=CHANGE_ME_APP
MIGRATOR_DB_USER=ecommerce_staging_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR
DATABASE_URL=postgresql+psycopg://ecommerce_staging_app:CHANGE_ME_APP@postgres:5432/ecommerce_staging
MIGRATION_DATABASE_URL=postgresql+psycopg://ecommerce_staging_migrator:CHANGE_ME_MIGRATOR@postgres:5432/ecommerce_staging

# 使用极空间“查询路径”得到真实宿主机路径后填写
POSTGRES_DATA_DIR_HOST=/CHANGE_ME/ecommerce/staging/postgres
REDIS_DATA_DIR_HOST=/CHANGE_ME/ecommerce/staging/redis
DATA_DIR_HOST=/CHANGE_ME/ecommerce/staging/data

# 下面继续放业务运行凭证，例如 APP_SECRET_KEY / ADMIN_* / JACKYUN_* / 1688 / SMTP。
APP_SECRET_KEY=CHANGE_ME
ACCESS_MODE=rbac
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
