# 极空间 PRODUCTION 示例。复制为 .env 后填写真实值，不要提交 .env。
COMPOSE_PROJECT_NAME=ecommerce-prod
# 正式部署建议改成具体 vYYYY.MM.DD.HHmmss 标签；stable 仅用于发现最新版。
APP_IMAGE=ghcr.io/jinfenghua1990/ecommerce-workspace:stable
WEB_PORT=8000
APP_ENV=production
RELEASE_CHANNEL=stable

POSTGRES_DB=ecommerce
# 数据库 owner/admin。已有 PostgreSQL 数据卷不要随意改这个用户名。
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME_ADMIN
APP_DB_USER=ecommerce_app
APP_DB_PASSWORD=CHANGE_ME_APP
MIGRATOR_DB_USER=ecommerce_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR
DATABASE_URL=postgresql+psycopg://ecommerce_app:CHANGE_ME_APP@postgres:5432/ecommerce
MIGRATION_DATABASE_URL=postgresql+psycopg://ecommerce_migrator:CHANGE_ME_MIGRATOR@postgres:5432/ecommerce

# 使用极空间“查询路径”得到真实宿主机路径后填写
POSTGRES_DATA_DIR_HOST=/CHANGE_ME/ecommerce/production/postgres
REDIS_DATA_DIR_HOST=/CHANGE_ME/ecommerce/production/redis
DATA_DIR_HOST=/CHANGE_ME/ecommerce/production/data

APP_SECRET_KEY=CHANGE_ME
ACCESS_MODE=rbac
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
