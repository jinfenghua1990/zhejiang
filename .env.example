# ===== 运行环境 =====
# production / staging / development
APP_ENV=production
# stable=正式发布；candidate=测试候选
RELEASE_CHANNEL=stable
# native=本机 Git/LaunchAgent；container=Docker/Compose 托管
DEPLOYMENT_MODE=native
# 容器构建时写入 GIT_SHA；Compose 运行时写入 APP_IMAGE_REF。
GIT_SHA=
APP_IMAGE_REF=

# 持久化数据必须与代码仓库分离。
# production 必须显式配置 PERSIST_ROOT，且 PERSIST_ROOT / DATA_DIR / BACKUP_DIR / LOG_DIR
# 均不得位于 ecommerce-workspace 代码目录内，否则系统更新会被硬性阻止。
# 原生部署示例：/Users/<user>/ecommerce-workspace-data/production
# staging/development 仍允许旧目录兼容，但更新中心会显示分离警告。
PERSIST_ROOT=
DATA_DIR=
BACKUP_DIR=
LOG_DIR=
# Docker Compose 宿主机持久化目录；正式环境建议改为仓库外绝对路径。
DATA_DIR_HOST=./data

# ===== 基础 =====
APP_SECRET_KEY=
ACCESS_MODE=rbac
RUNTIME_UID=1000
RUNTIME_GID=1000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
FORCE_ADMIN_PASSWORD=0
DATABASE_URL=
# Alembic/发布迁移专用连接；为空时兼容使用 DATABASE_URL。production 建议独立 migrator 账号。
MIGRATION_DATABASE_URL=
REDIS_URL=

# ===== 吉客云 MCP（Phase 1）=====
JACKYUN_MCP_URL=
JACKYUN_APP_KEY=
JACKYUN_MCP_TOKEN=
JACKYUN_SYNC_MODE=manual

# ===== 吉客云销售订单三通道 =====
JKY_ORDER_PROVIDER_PRIORITY=jky_web,jky_rpa,jky_api
JKY_ORDER_SYNC_INTERVAL_MINUTES=30
JKY_ORDER_SYNC_OVERLAP_MINUTES=30
JKY_ORDER_INITIAL_LOOKBACK_DAYS=3
JKY_ORDER_STALE_RUN_MINUTES=180
JKY_ORDER_LOW_COUNT_RATIO=0.25
JKY_RPA_AGENT_URL=
JKY_RPA_AGENT_TOKEN=
JKY_RPA_TIMEOUT_SECONDS=900
JKY_RPA_HEALTH_TIMEOUT_SECONDS=5
JKY_API_MAX_RETRIES=2

# ===== 1688 开放平台 =====
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_REDIRECT_URI=

# ===== 财务邮件 =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ===== Cloudflare R2 主备份 =====
# 每日 03:00 执行模块化备份；每 R2_FULL_INTERVAL_DAYS 自动插入一次完整容灾恢复点。
# 也可在系统“备份与容灾”页面加密保存，不需要把真实密钥写进 .env。
R2_BACKUP_ENABLED=0
R2_BACKUP_ENDPOINT=
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY=
R2_BACKUP_SECRET_KEY=
R2_BACKUP_PREFIX=ecommerce-workspace/backup
R2_FULL_INTERVAL_DAYS=10
# Mac 原生运行时自动安装/刷新本地基础、R2、Kodo 与恢复演练 launchd 计划。
BACKUP_SCHEDULE_AUTO_INSTALL=1

# ===== 七牛云 Kodo 国内冷备（只存不取）=====
# 仅使用标准存储。上传器只执行上传，不执行下载、取回、List、Head、远端校验或远端恢复。
# 凭据必须只写在实际部署的 .env 中，不要提交 GitHub。
KODO_COLD_ENABLED=0
KODO_COLD_BUCKET=
KODO_COLD_UPLOAD_URL=
KODO_COLD_ACCESS_KEY=
KODO_COLD_SECRET_KEY=
KODO_COLD_PREFIX=ecommerce-workspace/cold

# ===== 系统更新 =====
# production 固定跟踪 main；staging 固定跟踪 develop。
SYSTEM_UPDATE_ENABLED=1
SYSTEM_UPDATE_REMOTE=origin
SYSTEM_UPDATE_BRANCH=main
SYSTEM_UPDATE_REPO_ROOT=
SYSTEM_UPDATE_HEALTH_URL=http://127.0.0.1:8000/healthz
SYSTEM_UPDATE_LAUNCH_LABEL=com.gino.ecommerce-dashboard

# ===== Postgres =====
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME

# ===== 测试库 =====
TEST_DATABASE_URL=postgresql+psycopg://ecommerce:CHANGE_ME@localhost:5432/ecommerce_test
